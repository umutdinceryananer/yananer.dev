{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.functions.tsbuildinfo",
    "target": "ES2022",
    /* DOM, not @cloudflare/workers-types: the collector uses only Request,
       Response, Blob and URL, which the Workers runtime implements to the same
       shape, and the one binding it needs (D1) is declared inline. That keeps a
       types-only dependency out of the site's package.json -- the same trade
       mcp/src/worker.ts makes for its rate limiter. */
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* No ambient @types packages: this code runs on the edge, and letting
       @types/node's globals in here would typecheck against a runtime that is
       not there. */
    "types": [],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["functions"]
}
