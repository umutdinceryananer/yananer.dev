VITE_EMAILJS_PUBLIC_KEY="your_public_key_here"
VITE_EMAILJS_SERVICE_ID="your_service_id_here"
VITE_EMAILJS_TEMPLATE_ID="your_template_id_here"

# Where the tracker posts batches. Leave it unset and the whole tracker no-ops
# rather than 404ing in a loop -- which is what you want on a fork, in local
# development and on a preview deploy.
#
# The collector is a Pages Function in this repo (functions/api/collect.ts), so
# the value is a same-origin path, not a URL. That is load-bearing: `connect-src
# 'self'` in public/_headers already allows it, and a beacon blocked by CSP
# fails silently. scripts/audit-analytics.ts fails the build if this ever names
# an origin the CSP does not list.
#
# It must also be set in the Cloudflare Pages build environment for production,
# or the deployed site collects nothing and looks exactly like a site nobody
# visits.
VITE_ANALYTICS_ENDPOINT="/api/collect"
