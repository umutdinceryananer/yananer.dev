{
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.analytics.tsbuildinfo",
    "target": "ES2022",
    /* DOM for Request/Response/URL, which the Workers runtime implements to the
       same shape. The one binding this needs is declared inline, so no Workers
       types package is required -- the same trade mcp/src/worker.ts makes. */
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* No ambient @types: this runs on the edge, and checking it against Node's
       globals would be checking it against a runtime that is not there. */
    "types": [],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
